# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# n8n has TWO separate webhooks. Add both in the AI Studio Secrets panel (same way as GEMINI_API_KEY).
#
# N8N_BOOKING_WEBHOOK_URL → "Collecter" node in n8n — triggered for every NEW customer booking.
#   TEST:       https://fahad97.app.n8n.cloud/webhook-test/7fcc4e77-6172-4476-a706-2864a4a0ae92
#   PRODUCTION: https://fahad97.app.n8n.cloud/webhook/7fcc4e77-6172-4476-a706-2864a4a0ae92
N8N_BOOKING_WEBHOOK_URL="https://fahad97.app.n8n.cloud/webhook-test/7fcc4e77-6172-4476-a706-2864a4a0ae92"

# N8N_APPROVAL_WEBHOOK_URL → "Webhook" (manager-approval) node — triggered when manager approves/rejects.
#   TEST:       https://fahad97.app.n8n.cloud/webhook-test/manager-approval
#   PRODUCTION: https://fahad97.app.n8n.cloud/webhook/manager-approval
N8N_APPROVAL_WEBHOOK_URL="https://fahad97.app.n8n.cloud/webhook-test/manager-approval"

