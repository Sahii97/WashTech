# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# N8N_WEBHOOK_URL: Webhook URL used by the server to send requests to n8n.
# For TESTING: use the webhook-test URL shown in n8n when you click "Listen for test event".
# For PRODUCTION: use the production webhook URL (e.g. /webhook/manager-approval).
# Add this in the AI Studio Secrets panel (same way as GEMINI_API_KEY).
N8N_WEBHOOK_URL="https://fahad97.app.n8n.cloud/webhook-test/7fcc4e77-6172-4476-a706-2864a4a0ae92"

